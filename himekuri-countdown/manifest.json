{
  "manifest_version": 3,
  "name": "Himekuri Countdown",
  "version": "1.0.0",
  "description": "Turns your new tab into a flip-calendar countdown to a date you choose.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
